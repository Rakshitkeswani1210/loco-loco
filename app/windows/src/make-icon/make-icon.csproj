<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes src/LocoLoco/Assets/LocoLoco.ico and preview sheets from the same drawing code the app uses for its tray icon.
       Run it with scripts/make-icon.ps1, or dotnet run on this project with the .ico path and an optional preview folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MakeIcon</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../LocoLoco/Art/*.cs" Link="Art/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
