<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tray app: WinUI 3, unpackaged and self-contained, so there is no runtime to install.
       The UI is built in C# with no XAML files, so the project also compiles on a Mac for quick checks. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>LocoLoco</RootNamespace>
    <AssemblyName>Loco Loco</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Self-contained needs a runtime, so a plain dotnet build or run on Windows builds for that PC. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <!-- Builds resources.pri, merged with WinUI's own resources, which an unpackaged app looks for first. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <ApplicationIcon>Assets\LocoLoco.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="H.NotifyIcon" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocoCore\LocoCore.csproj" />
  </ItemGroup>

  <!-- Compile checks on a Mac only. Windows and CI build the real thing. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained merges manifests with mt.exe, which only runs on Windows. -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <!-- The Mac's package mirror stops at the 10.0.12 Windows desktop reference pack. -->
  <Target Name="UseMirroredDesktopPack" BeforeTargets="ProcessFrameworkReferences" Condition="'$(OS)' != 'Windows_NT'">
    <ItemGroup>
      <KnownFrameworkReference Condition="'%(KnownFrameworkReference.TargetingPackVersion)' == '10.0.13'">
        <TargetingPackVersion>10.0.12</TargetingPackVersion>
        <LatestRuntimeFrameworkVersion>10.0.12</LatestRuntimeFrameworkVersion>
      </KnownFrameworkReference>
    </ItemGroup>
  </Target>
</Project>
